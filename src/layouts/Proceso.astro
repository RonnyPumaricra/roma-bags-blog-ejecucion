---
import '../css/contenido.css';
import Layout from './Layout.astro';
import Paginacion from '../components/paginacion.astro';
import StatusIcon from '../components/status-icon.vue';
import { ESTADOS, NOMBRE_AREA, NOMBRE_DOMINIO, PROCESOS, procesoPorId, type Proceso } from '../data/procesos';

interface Props {
  frontmatter: {
    id: string;
    /** Fecha de la última edición, p. ej. "14 sep 2026" */
    editado?: string;
  };
}

const { id, editado } = Astro.props.frontmatter;
const proceso = procesoPorId(id);
if (!proceso) throw new Error(`Proceso desconocido en el frontmatter: ${id}`);

const i = PROCESOS.indexOf(proceso);
const enlace = (p: Proceso | undefined) =>
  p && { href: `/proceso/${p.id}`, contexto: NOMBRE_AREA[p.area], texto: `${p.id} ${p.nombre}` };
const colores = `--c: var(--d-${proceso.dominio}); --o: var(--o-${proceso.dominio})`;
---

<Layout title={`${proceso.id} ${proceso.nombre}`}>
  <div class="crumbs"><a href="/">Inicio</a> › <a href={`/area/${proceso.area}`}>{NOMBRE_AREA[proceso.area]}</a></div>

  <div class="ptop">
    <span class="num-chip" style={colores}>{proceso.id}</span>
    <span class="dom-chip" style={colores}>{NOMBRE_DOMINIO[proceso.dominio]}</span>
    <span class="badge"><StatusIcon estado={proceso.estado} size={11} />{ESTADOS[proceso.estado]}</span>
    {editado && <span class="editado">Editado el {editado}</span>}
    <a class="ver-mapa" href={`/mapa#${proceso.id}`}>Ver en el mapa</a>
  </div>

  <h1>{proceso.nombre}</h1>

  {
    proceso.estado === 'pen' ? (
      <div class="notice">Página pendiente. Se completará cuando el proceso se trabaje en clase.</div>
    ) : (
      <div class="contenido">
        <slot />
      </div>
    )
  }

  <Paginacion anterior={enlace(PROCESOS[i - 1])} siguiente={enlace(PROCESOS[i + 1])} />
</Layout>

<style>
  .crumbs {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 10px;
  }

  .crumbs a {
    color: var(--muted);
  }

  .ptop {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
  }

  .num-chip {
    font-size: 12px;
    font-weight: 800;
    padding: 3px 9px;
    border-radius: 6px;
    background: var(--c);
    color: var(--o);
    font-variant-numeric: tabular-nums;
  }

  .dom-chip {
    font-size: 12px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--c);
    color: var(--o);
    white-space: nowrap;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 6px;
    text-transform: uppercase;
    letter-spacing: .03em;
    white-space: nowrap;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--text);
  }

  .editado {
    font-size: 13px;
    color: var(--muted);
  }

  .ver-mapa {
    margin-left: auto;
    font-size: 13px;
  }

  h1 {
    margin: 12px 0 8px;
  }

  .notice {
    padding: 14px 16px;
    border-radius: 10px;
    border: 1px dashed var(--line);
    background: var(--surface);
    color: var(--muted);
    margin: 20px 0;
  }
</style>
