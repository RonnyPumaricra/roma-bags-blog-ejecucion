---
import '../css/arbol.css';
import BotonIndice from './boton-indice.vue';
import { FASES, PROYECTO, PROYECTO_DETALLE, TOTAL_ACTIVIDADES, TOTAL_PAQUETES } from '../data/edt';
---

<figure class="arbol" style="--c: var(--d-alc); --oc: var(--o-alc)" aria-label="Estructura de desglose del trabajo">
  <figcaption class="herramientas">
    <span><span class="rombo">◆</span> hito · Toca un paquete para ver sus actividades del cronograma.</span>
    <span class="sp"></span>
    <button type="button" class="btn-ghost" data-desplegar>Desplegar todo</button>
    <BotonIndice client:load />
  </figcaption>

  <div class="nodo raiz">
    <span class="cod">1</span>
    <strong>{PROYECTO}</strong>
    <small>{PROYECTO_DETALLE} · {TOTAL_PAQUETES} paquetes · {TOTAL_ACTIVIDADES} actividades</small>
  </div>

  <ul class="ramas">
    {
      FASES.map((fase) => (
        <li>
          <div class="nodo rama">
            <span class="cod">{fase.id}</span>
            <strong>{fase.nombre}</strong>
            <small>{fase.detalle}</small>
          </div>
          <ul class="hojas">
            {fase.paquetes.map((paquete) => (
              <li>
                <details class="nodo hoja">
                  <summary>
                    <span class="cod">{paquete.id}</span>
                    <strong>{paquete.nombre}</strong>
                    <small>
                      {paquete.actividades.length} {paquete.actividades.length === 1 ? 'actividad' : 'actividades'}
                    </small>
                  </summary>
                  <p class="detalle">{paquete.entregable}</p>
                  <p class="nota">Responsable: {paquete.responsable}</p>
                  <ol>
                    {paquete.actividades.map((a) => (
                      <li class:list={{ hito: a.hito }}>
                        <span class="cod">{a.codigo}</span>
                        <span>
                          {a.hito && <span class="rombo" title="Hito">◆ </span>}
                          {a.nombre}
                        </span>
                      </li>
                    ))}
                  </ol>
                </details>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</figure>

<script>
  import '../scripts/desplegar-arbol';
</script>
