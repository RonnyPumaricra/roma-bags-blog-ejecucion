---
/* Panel de una pestaña del layout PlanDireccion; `id` debe coincidir con el de una sección */
interface Props {
  id: string;
  /** Posición de la pestaña (1, 2, 3…); numera el título y deja visible solo el primero sin JS */
  n: number;
  titulo: string;
  sub?: string;
}

const { id, n, titulo, sub } = Astro.props;
---

<section class="panel" id={id} role="tabpanel" aria-labelledby={`tab-${id}`} tabindex="0" hidden={n > 1}>
  <h2>{n}. {titulo}</h2>
  {sub && <p class="sub">{sub}</p>}
  <slot />
</section>
