---
import Layout from '../layouts/Layout.astro';
import MapaProcesos from '../components/mapa-procesos.vue';
---

<Layout title="Mapa de procesos" narrow={false}>
  <div class="crumbs"><a href="/">Inicio</a> › Mapa de procesos</div>
  <h1>Mapa de procesos</h1>
  <p class="lead">
    Flujo de los 19 procesos de Ejecución, Monitoreo y Control, y Cierre, agrupados como en el flujo de procesos
    de la Guía PMBOK® 8.ª ed. El filtro de dominio también se aplica aquí.
  </p>
  <MapaProcesos client:load />
</Layout>

<style>
  .crumbs {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 10px;
  }

  .crumbs a {
    color: var(--muted);
  }

  h1 {
    margin: 4px 0 8px;
  }

  .lead {
    color: var(--muted);
    font-size: 16px;
    max-width: 72ch;
  }
</style>
