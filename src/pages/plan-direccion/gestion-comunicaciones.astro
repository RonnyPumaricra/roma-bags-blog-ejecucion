            <tr><td>COM-13</td><td><strong>Convocatoria a capacitación</strong></td><td>Citar y registrar asistencia.</td><td>Líder → Ventas, Producción, Gerencia</td><td>WhatsApp + presencial; lista de asistencia</td><td>17–24/03/2027</td><td>1.5.7–1.5.9</td></tr>
